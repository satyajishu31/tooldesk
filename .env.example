# ──────────────────────────────────────────────────────────────
# Environment variables for ToolDesk backend functions
#
# These are SERVER-SIDE ONLY. They power the Netlify Functions in
# /netlify/functions and are never sent to the browser. Do NOT prefix
# any of these with VITE_ — that would bundle them into client-side
# JS and expose them publicly.
#
# Local development (netlify dev or vite):
#   1. Copy this file to `.env` in the project root.
#   2. Fill in your real API keys in `.env`.
#   3. `.env` is gitignored — never commit real keys.
#
# Production (Netlify):
#   Site settings → Environment variables → add each key there.
#   Never put real keys in this file or in git history.
# ──────────────────────────────────────────────────────────────

# Background remover (BGRemover tool, "AI" mode) — https://www.remove.bg/api
# Used by: netlify/functions/removebg.js
REMOVE_BG_API_KEY=your_remove_bg_api_key_here
# Optional rotation fallback keys:
# REMOVE_BG_API_KEY_2=
# REMOVE_BG_API_KEY_3=
# REMOVE_BG_API_KEY_4=

# AI text and voice tools — https://console.groq.com
# Used by: netlify/functions/groq-ai.js, transcribe.js
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Translation tool — https://www.deepl.com/pro-api
# Used by: netlify/functions/deepl.js
DEEPL_API_KEY=your_deepl_api_key_here

# Have I Been Pwned check — https://haveibeenpwned.com/API/Key
# Used by: netlify/functions/hibp.js
HIBP_API_KEY=your_hibp_api_key_here

# Upstash Redis for distributed serverless rate limiting (Optional)
# https://upstash.com
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Optional search API for CountryFinder live research
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# ──────────────────────────────────────────────────────────────
# ToolDesk Client-Side App Release & Distribution URLs
# (Safe public URLs pointing to GitHub Releases, CDN hosting, or Netlify staging)
# ──────────────────────────────────────────────────────────────
VITE_RELEASE_VERSION=1.0.0
# VITE_GITHUB_REPO=tooldesk/tooldesk
# VITE_WINDOWS_EXE_URL=https://github.com/tooldesk/tooldesk/releases/download/v1.0.0/ToolDesk-Setup.exe
# VITE_WINDOWS_MSI_URL=https://github.com/tooldesk/tooldesk/releases/download/v1.0.0/ToolDesk.msi
# VITE_MAC_DMG_URL=https://github.com/tooldesk/tooldesk/releases/download/v1.0.0/ToolDesk.dmg
# VITE_MAC_APP_URL=https://github.com/tooldesk/tooldesk/releases/download/v1.0.0/ToolDesk-macOS.zip
# VITE_LINUX_APPIMAGE_URL=https://github.com/tooldesk/tooldesk/releases/download/v1.0.0/ToolDesk.AppImage
# VITE_LINUX_DEB_URL=https://github.com/tooldesk/tooldesk/releases/download/v1.0.0/ToolDesk.deb
# VITE_ANDROID_APK_URL=https://github.com/tooldesk/tooldesk/releases/download/v1.0.0/ToolDesk.apk
# VITE_ANDROID_AAB_URL=https://github.com/tooldesk/tooldesk/releases/download/v1.0.0/ToolDesk.aab
# VITE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.tooldesk.app
# VITE_IOS_STORE_URL=https://apps.apple.com/app/tooldesk/id...
# VITE_IOS_TESTFLIGHT_URL=https://testflight.apple.com/join/...
