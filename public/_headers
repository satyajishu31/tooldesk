/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob: https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: data:; connect-src 'self' blob: data: https://api.groq.com https://api.remove.bg https://api-free.deepl.com https://api.deepl.com https://api.pwnedpasswords.com https://haveibeenpwned.com https://api.search.brave.com https://ipapi.co https://ipwho.is https://ipwhois.app https://freeipapi.com https://www.googleapis.com https://fonts.googleapis.com https://fonts.gstatic.com https://api.frankfurter.dev https://restcountries.com https://vimeo.com https://unpkg.com https://*.supabase.co https://api.github.com https://github.com ws://localhost:* wss://localhost:*; worker-src 'self' blob: https://cdn.jsdelivr.net https://unpkg.com; child-src 'self' blob:; frame-ancestors 'none';

/releases.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=60, s-maxage=300
  Access-Control-Allow-Origin: *

/releases/android/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="ToolDesk.apk"
  Cache-Control: public, max-age=604800, immutable

/releases/android/*.aab
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="ToolDesk.aab"
  Cache-Control: public, max-age=604800, immutable

/releases/macos/*.dmg
  Content-Type: application/x-apple-diskimage
  Content-Disposition: attachment; filename="ToolDesk.dmg"
  Cache-Control: public, max-age=604800, immutable

/releases/macos/*.zip
  Content-Type: application/zip
  Content-Disposition: attachment; filename="ToolDesk-macOS.zip"
  Cache-Control: public, max-age=604800, immutable

/releases/windows/*.exe
  Content-Type: application/vnd.microsoft.portable-executable
  Content-Disposition: attachment; filename="ToolDesk-Setup.exe"
  Cache-Control: public, max-age=604800, immutable

/releases/windows/*.msi
  Content-Type: application/x-msi
  Content-Disposition: attachment; filename="ToolDesk.msi"
  Cache-Control: public, max-age=604800, immutable

/releases/linux/*.AppImage
  Content-Type: application/x-executable
  Content-Disposition: attachment; filename="ToolDesk.AppImage"
  Cache-Control: public, max-age=604800, immutable

/releases/linux/*.deb
  Content-Type: application/vnd.debian.binary-package
  Content-Disposition: attachment; filename="ToolDesk.deb"
  Cache-Control: public, max-age=604800, immutable

/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate

/sw-chunks.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate

